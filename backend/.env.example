# 数据库连接（默认 SQLite 便于本地零依赖跑通；生产切 MySQL）
# DATABASE_URL=mysql+pymysql://pharma:pharma123@localhost:3306/collab_docs
DATABASE_URL=sqlite:///./collab_docs.db

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=10080

# 文件存储根目录
FILE_ROOT=./data/files

# OnlyOffice（留空则协同编辑降级为预览提示）
ONLYOFFICE_URL=
ONLYOFFICE_SECRET=onlyoffice-shared-secret
APP_BASE_URL=http://localhost:8000

# 允许的前端来源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 运行环境（dev / prod；prod 会强制校验 JWT_SECRET 强度）
ENV=dev

# 登录限流：窗口内失败 N 次 → 锁定 M 秒
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW=300
RATE_LIMIT_LOCK=900
